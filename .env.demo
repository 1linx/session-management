# Anonymised demo — loaded by `npm run demo` (vite dev --mode demo), on top
# of .env. Safe to commit: no secrets, no real names.
#
# Fictional data set from `npm run demo:seed` — never point this at a real database.
DATABASE_URL=demo.db

# Fictional practice names shown everywhere in the UI (stored values are unchanged).
PUBLIC_MAIN_PRACTICE_NAME=Riverside
PUBLIC_MAIN_PRACTICE_SHORT=RS
PUBLIC_BRANCH_PRACTICE_NAME=Hillcrest
PUBLIC_BRANCH_PRACTICE_SHORT=HC

# The Raw data page shows stored keys, which name the real practices — hide it.
PUBLIC_HIDE_RAW_DATA=true

# Live updates off: demo saves must never ping the real rota's channel.
PUBLIC_REALTIME_CHANNEL=
